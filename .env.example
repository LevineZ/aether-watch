# Copy to .env for local overrides. Defaults in docker-compose.yml work as-is.

POSTGRES_USER=aether
POSTGRES_PASSWORD=aether
POSTGRES_DB=aetherwatch

# MinIO (S3-compatible). Local-only credentials — change if you expose the stack.
MINIO_ROOT_USER=aetherwatch
MINIO_ROOT_PASSWORD=aetherwatch_dev
MINIO_BUCKET=aetherwatch

# Optional. If set, admin upload requires header X-Admin-Token.
ADMIN_TOKEN=aether-dev

# Public forecast / marine providers (no API key for non-commercial use)
OPEN_METEO_BASE=https://api.open-meteo.com
OPEN_METEO_MARINE_BASE=https://marine-api.open-meteo.com

# Grid density vs Open-Meteo rate limits. Defaults prefer stability over density.
# Override upward only if you have quota headroom (compose interpolates these).
FIELD_NX=20
FIELD_NY=15
CURRENT_NX=16
CURRENT_NY=8
# Conservative Open-Meteo pacing — never hammer the free API.
# concurrency=1, small batches, ≥0.75s between requests, exponential 429 backoff.
OPEN_METEO_BATCH_SIZE=40
OPEN_METEO_CONCURRENCY=1
OPEN_METEO_MIN_INTERVAL_SECONDS=0.75
OPEN_METEO_MAX_RETRIES=6
OPEN_METEO_BACKOFF_BASE=2.0

# Redis TTLs (seconds). Last-good / stale is served on upstream 429.
CACHE_TTL_SECONDS=21600
WIND_CACHE_TTL_SECONDS=21600
CURRENT_CACHE_TTL_SECONDS=21600
CATALOG_CACHE_TTL_SECONDS=3600
LAST_GOOD_TTL_SECONDS=604800
OPEN_METEO_STALE_TTL_SECONDS=604800

# Published site port on the host (Caddy)
AETHERWATCH_PORT=8765
